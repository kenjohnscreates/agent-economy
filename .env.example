# Agent Town — environment template
# Copy to .env; never commit .env (.gitignore blocks .env and .env.* but whitelists this file).
# Source of truth for the variable list: docs/ARCHITECTURE.md §8 (constants: §2).
# Every var below: what it is · where to get it · first milestone that needs it.
# Public, non-secret defaults are pre-filled; everything secret is left empty.

# ─── Arc / chain ────────────────────────────────────────────────────────────────
# Arc Testnet chain id (docs.arc.network) · public constant · M0.8
ARC_CHAIN_ID=5042002
# Ethereum Sepolia chain id (ENSv2 hackathon deployment lives here) · public constant · M0.3
SEPOLIA_CHAIN_ID=11155111
# Arc Testnet JSON-RPC (alts: blockdaemon / drpc / quicknode subdomains, see ARCHITECTURE §2) · https://docs.arc.network · M0.8
ARC_RPC_URL=https://rpc.testnet.arc.io
# USDC ERC-20 interface on Arc, 6 decimals. Native gas balance (eth_getBalance) is 18 decimals — never mix. · ARCHITECTURE §2 · M0.8
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# TownTreasury.sol address on Arc Testnet; written after deploy (also deployments/arc-testnet.json) · https://testnet.arcscan.app · M1.2
TOWN_TREASURY_ADDRESS=
# TownTreasury constructor: owner (mayor) address — receives Ownable2Step ownership + DEFAULT_ADMIN_ROLE. Usually the deployer EOA · M1.2
TREASURY_OWNER=
# TownTreasury constructor: initial TREASURER_ROLE holder (treasurer agent's Circle SCA on ARC-TESTNET). Empty = grant later via grantRole · M1.2
TREASURER_ADDRESS=
# TownTreasury constructor: initial base rate in bps, bounds 100–2000 (packages/shared rules BASE_RATE_MIN/MAX_BPS) · M1.2
BASE_RATE_BPS=600
# TownTreasury constructor: seconds after a loan's dueAt before the treasurer may markDefault (≈ GRACE_TICKS × TICK_MS at demo cadence) · M1.2
GRACE_SECONDS=120
# ERC-8183 reference jobs contract predeployed on Arc Testnet · ARCHITECTURE §2 · M1.5
ERC8183_ADDRESS=0x0747EEf0706327138c69792bF28Cd525089e4583
# Sepolia JSON-RPC for ENSv2 reads/writes · e.g. https://dashboard.alchemy.com or https://www.infura.io (or public https://rpc.sepolia.org) · M0.3
SEPOLIA_RPC_URL=
# SECRET. Hex private key used by Foundry deploy scripts only (Arc + Sepolia). Fund with Arc faucet USDC + ≥0.5 Sepolia ETH · https://faucet.circle.com , https://sepoliafaucet.com · M1.2
DEPLOYER_PRIVATE_KEY=

# ─── Circle (Developer-Controlled Wallets, blockchain ARC-TESTNET) ──────────────
# SECRET. Circle Console API key (Testnet) · https://console.circle.com → API Keys · M0.1 (used M1.3)
CIRCLE_API_KEY=
# SECRET. Entity secret, 32-byte hex, generated locally and REGISTERED in Console (keep recovery file offline) · https://developers.circle.com/w3s/entity-secret-management · M0.1 (used M1.3)
CIRCLE_ENTITY_SECRET=
# Wallet set id that holds the 9 SCA wallets (8 agents + mayor) on ARC-TESTNET; created via Console or packages/circle script · https://console.circle.com → Wallets · M1.3
CIRCLE_WALLET_SET_ID=
# Name given to the wallet set when packages/circle `setup-wallets --yes` creates it (only used if CIRCLE_WALLET_SET_ID is empty) · local · M1.3
CIRCLE_WALLET_SET_NAME=agent-town

# ─── ENS (ENSv2 hackathon deployment on Sepolia) ────────────────────────────────
# Town root label (decided Sep 8): botanica → botanica.eth, agents ada.botanica.eth …; registered on the ENSv2 hackathon ETH Registrar (commit-reveal) · https://docs.ens.domains (hackathon banner) · M0.4
ENS_TOWN_NAME=botanica
# UniversalResolverV2 address of the hackathon deployment (from packages/ens/deployments.json) · https://docs.ens.domains → hackathon feature branch · M0.3
ENS_UNIVERSAL_RESOLVER_V2=
# Town subregistry address deployed via VerifiableFactory · fill from `pnpm --filter @agent-town/ens deploy-town-subregistry -- --broadcast` (prints + packages/ens/town.json). Do not invent. · M2.1
ENS_TOWN_REGISTRY=
# Town PermissionedResolver address deployed via VerifiableFactory · same command as ENS_TOWN_REGISTRY · M2.1
ENS_TOWN_RESOLVER=
# TownRegistrar.sol address (register(label, owner, role) with per-role EAC) · own deployment · M2.2
ENS_TOWN_REGISTRAR=
# SECRET. Sepolia signer that owns <town>.eth and writes records (credit score, reviews, revoke). Fund ≥0.5 Sepolia ETH (RISKS R13) · https://sepoliafaucet.com · M0.4 (writes M2.3+)
ENS_TREASURER_PRIVATE_KEY=

# ─── Graph ──────────────────────────────────────────────────────────────────────
# SECRET. Subgraph Studio API key for querying via the decentralized gateway · https://thegraph.com/studio → API Keys · M0.1 (used M0.9 / M3.4)
GRAPH_API_KEY=
# Query URL of our `agent-town` subgraph (network: Arc Testnet) after Studio deploy · https://thegraph.com/studio · M3.3
SUBGRAPH_URL=
# Signal C: Messari lending Aave V3 Ethereum (public id JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk; 30d MCP count 0, top query-fees vs Aave V3 Pool) · https://thegraph.com/explorer · M0.9
EXT_LENDING_SUBGRAPH_ID=JCNWRypm7FYwV8fx5HhzZPSFaMxgkPuw4TnR3Gpi81zk
# Signal C: Uniswap V3 Ethereum official (public id 5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV; 30d MCP count 0, top query-fees vs Uni V3 Factory). Messari DEX 4cKy6… is live but lower fee-rank · https://thegraph.com/explorer · M0.9
EXT_DEX_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Kill switch for Signal C external market data (on|off); off → rules use last-known/stale defaults (RISKS R17) · local flag · M4.9
EXTERNAL_SIGNALS=on
# Hard cap on ticks per sim run (demo safety) · local flag · M4.1
MAX_TICKS=50
# Storyline mode: demo (PRD §12 tick table) | free (constant boom phase) · local flag · M4.1
STORYLINE=demo

# ─── LLM (optional until M4; RISKS R7 — rules run without a key) ────────────────
# anthropic | openai | off. Treasurer advisor + narrator; `off` = rules-only reasoning text · local flag · M4.4
LLM_PROVIDER=off
# Kill switch for treasurer LLM advisor (on|off); default off — rules-only until M4.4 · local flag · M4.1
LLM_ADVISOR=off
# Kill switch for agent narrator LLM (on|off); default off — static persona lines (RISKS R7) · local flag · M4.5
LLM_NARRATOR=off
# SECRET. Anthropic API key (needed only if LLM_PROVIDER=anthropic) · https://console.anthropic.com/settings/keys · M4.4
ANTHROPIC_API_KEY=
# SECRET. OpenAI API key (needed only if LLM_PROVIDER=openai) · https://platform.openai.com/api-keys · M4.4
OPENAI_API_KEY=

# ─── App ────────────────────────────────────────────────────────────────────────
# Supabase project URL (action ledger, narration, tick state) · https://supabase.com/dashboard → Project Settings → API · M4.1
SUPABASE_URL=
# SECRET. Supabase service-role key (server side only; never ship to the browser) · https://supabase.com/dashboard → Project Settings → API · M4.1
SUPABASE_SERVICE_KEY=
# Milliseconds between sim ticks (tunable; RISKS R9) · local flag · M4.1
TICK_MS=15000
# Public base URL of apps/api consumed by apps/web (mock in M0.7, real in M4.7) · local · M0.7
NEXT_PUBLIC_API_URL=http://localhost:3001
# apps/api data source: mock (shared fixtures + fake tick loop) | real (501 until M4.7); `--mock` flag also works · local flag · M0.7
API_MODE=mock
# Milliseconds between mock ticks (faster than TICK_MS so FE sees movement quickly) · local flag · M0.7
MOCK_TICK_MS=5000
