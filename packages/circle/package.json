{
  "name": "@agent-town/circle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "roster.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "setup-wallets": "node --env-file-if-exists=../../.env --import tsx scripts/setup-wallets.ts",
    "balances": "node --env-file-if-exists=../../.env --import tsx scripts/balances.ts",
    "fund": "node --env-file-if-exists=../../.env --import tsx scripts/fund.ts",
    "job-e2e": "node --env-file-if-exists=../../.env --import tsx scripts/job-e2e.ts",
    "treasury-e2e": "node --env-file-if-exists=../../.env --import tsx scripts/treasury-e2e.ts"
  },
  "dependencies": {
    "@agent-town/shared": "workspace:*",
    "@circle-fin/developer-controlled-wallets": "10.8.0",
    "viem": "2.56.3",
    "zod": "4.5.4"
  }
}
