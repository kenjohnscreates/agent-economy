{
  "name": "@agent-town/graphclient",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "pnpm codegen && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@agent-town/shared": "workspace:*",
    "graphql": "16.11.0",
    "graphql-request": "7.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@agent-town/shared": "workspace:*",
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-graphql-request": "7.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "vitest": "^4.1.11"
  }
}
